 "segments": [
  {
   "s": 0.0,
   "e": 2.62,
   "text": "My son's wart hurts, and I can't fix it."
  },
  {
   "s": 2.94,
   "e": 5.2,
   "text": "Everything we tried hurt him more."
  },
  {
   "s": 5.92,
   "e": 7.74,
   "text": "A wart on his foot for a year."
  },
  {
   "s": 8.3,
   "e": 10.66,
   "text": "Store acid was too painful for him."
  },
  {
   "s": 11.24,
   "e": 12.86,
   "text": "So the doctor froze it."
  },
  {
   "s": 13.4,
   "e": 14.3,
   "text": "We held him still."
  },
  {
   "s": 14.94,
   "e": 17.4,
   "text": "He screamed, and it grew back anyway."
  },
  {
   "s": 18.12,
   "e": 19.98,
   "text": "Turns out, I didn't fail him."
  },
  {
   "s": 20.6,
   "e": 21.8,
   "text": "Here's what the freeze missed."
  },
  {
   "s": 22.1,
   "e": 25.58,
   "text": "Freezing, acid, and shaving only snap off the top,"
  },
  {
   "s": 25.88,
   "e": 27.14,
   "text": "like picking a dandelion."
  },
  {
   "s": 27.7,
   "e": 29.6,
   "text": "The root stays under the hard skin,"
  },
  {
   "s": 29.6,
   "e": 35.32,
   "text": "So it grows back. That's why I switched to root out. It's an oil with four plants in it"
  },
  {
   "s": 35.32,
   "e": 37.78,
   "text": "The lemon opens up that hard skin"
  },
  {
   "s": 37.78,
   "e": 44.52,
   "text": "The tea tree carries it down up to eight times deeper than a regular cream and the pokeweed and white cedar"
  },
  {
   "s": 44.52,
   "e": 51.22,
   "text": "Break the wart down from the root. Deep doesn't mean harsh. It's a kid's formula ages four and up"
  },
  {
   "s": 51.22,
   "e": 54.1,
   "text": "No blister just a little cool tingle"
  },
  {
   "s": 54.1,
   "e": 56.2,
   "text": "recommended by pediatricians."
  },
  {
   "s": 56.52,
   "e": 58.12,
   "text": "Bedtime takes two minutes."
  },
  {
   "s": 58.72,
   "e": 61.02,
   "text": "First, two light strokes with the file."
  },
  {
   "s": 61.5,
   "e": 62.8,
   "text": "That opens up the hardtop."
  },
  {
   "s": 63.2,
   "e": 66.54,
   "text": "Only the hardtop, never his skin, so it doesn't hurt."
  },
  {
   "s": 67.1,
   "e": 68.78,
   "text": "Next, I brush the oil on."
  },
  {
   "s": 69.3,
   "e": 71.2,
   "text": "Then a clear dot seals it in,"
  },
  {
   "s": 71.4,
   "e": 72.98,
   "text": "so it keeps soaking all night."
  },
  {
   "s": 73.6,
   "e": 75.72,
   "text": "No cold can, no acid."
  },
  {
   "s": 76.34,
   "e": 77.54,
   "text": "Nobody holds him down."
  },
  {
   "s": 78.12,
   "e": 80.7,
   "text": "My son's five, he hated the freeze."
  },
  {
   "s": 80.7,
   "e": 87.78,
   "text": "this he just sticks his foot out at bedtime. Does it sting? He says it's just a"
  },
  {
   "s": 87.78,
   "e": 90.6,
   "text": "little cool. We call it his wart chapstick."
  },
  {
   "s": 94.5,
   "e": 100.18,
   "text": "Two minutes at bedtime. No holding him down, no fight. Another freeze he cries"
  },
  {
   "s": 100.18,
   "e": 105.96,
   "text": "through or two minutes at bedtime. Get yours from the link below. Buy two, the"
  },
  {
   "s": 105.96,
   "e": 110.74,
   "text": "The third's free, and if it's not gone, you get your money back, any time in the first"
  },
  {
   "s": 110.74,
   "e": 111.5,
   "text": "90 days."
  }
 ]
}
