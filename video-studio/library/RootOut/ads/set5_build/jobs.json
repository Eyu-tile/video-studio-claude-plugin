 "vo": {
  "v01": [
   "071201_45a0a743-9df9-4787-9a7f-75d7a245ab75",
   "One brush of this on my son's wart at bedtime. He's asleep in two minutes. The wart isn't. Here's what happened over the next fourteen nights."
  ],
  "v02": [
   "071308_c4885ccd-386e-4a6e-baa3-d92755d0c8bc",
   "Night one."
  ],
  "v03": [
   "071600_ab3be412-f787-4dfc-aa11-0b182034c622",
   "Two light rubs with the little file, just on the hard top."
  ],
  "v04": [
   "071309_ce1bd938-b1b7-4eab-a4da-726a346bd22d",
   "Brush the oil on. A clear dot on top."
  ],
  "v06": [
   "071309_559332f5-f9ae-4aa0-9bde-72f02cb80112",
   "Two minutes. He didn't even look up from his book. He said it feels a little cool. That's it."
  ],
  "v07": [
   "071309_e6aeb9ad-1867-48e6-b607-cc92f3a8226a",
   "Here's what's going on in there tonight."
  ],
  "v08": [
   "071309_ff86c85c-24cc-462a-91d7-732d78ddfa8a",
   "The lemon softens that hard skin on top, so the oil can get in."
  ],
  "v09": [
   "071309_1a1544cb-ea78-4d2c-9a9d-2578678d112f",
   "The tea tree is a thin oil. It sinks in, up to eight times deeper than a regular cream, and carries the pokeweed and white cedar down with it."
  ],
  "v10": [
   "071309_ef0add35-5dd0-4c24-bfb2-0709f14350ed",
   "The dot keeps it all soaking till morning."
  ],
  "v11": [
   "071347_dac3cb58-6299-403b-9f8a-8fe8edfc6b0a",
   "Night three. The little black dots are fading."
  ],
  "v13": [
   "071309_553f27bb-1a35-4b92-8b84-182d051bb8d4",
   "That's all the freeze would have gotten."
  ],
  "v14": [
   "071309_1b777c5b-6ba1-4f30-b0af-e77a9d60db74",
   "Freezing, acid and shaving only snap off the top, like picking a dandelion. The root stays under the hard skin, so it grows back."
  ],
  "v16": [
   "071346_3cba9eed-6dd8-4371-a8fb-4f542d06552c",
   "Night seven. It's flatter."
  ],
  "v17": [
   "071312_ebf7a57d-1de7-471b-8fcc-69e1d2e2f0f6",
   "Pokeweed and white cedar are down at the root now, breaking the wart down from there, so it can't grow back."
  ],
  "v18": [
   "071312_1a9d1d0a-0fe9-4bbf-98d9-e99b2a3c025d",
   "And now he wants to do the brush himself."
  ],
  "v19": [
   "071347_58305ada-d879-4b34-9670-7685f64d05c2",
   "Night ten. He went barefoot at the pool. I only noticed on the drive home."
  ],
  "v20": [
   "071312_9c8476e8-0a65-4895-a039-6395aea7a27f",
   "Night fourteen. It's gone. Just smooth skin."
  ],
  "v21": [
   "071312_4f40240b-20b8-4089-89e6-25d7e91e2874",
   "Most spots are gone in about two weeks. But we keep going fourteen more nights, so the root is gone too."
  ],
  "v22": [
   "071312_b708b2cd-88d1-445c-a030-d0b228863aa7",
   "One little bottle, two minutes at bedtime. No freezing, no acid, no blister."
  ],
  "v23": [
   "071312_8ab1cd3c-af60-4552-8c4e-74973c930280",
   "It's a kids' formula, for ages four and up, and pediatricians recommend it."
  ],
  "v24": [
   "071312_1e1fd5d5-27de-45ca-b5f2-53d4a9898406",
   "She's four, and I was nervous. No crying, no fuss. She calls it her bedtime paint."
  ],
  "v25": [
   "071312_c4249852-3315-4eae-bcdf-f6230a9356bd",
   "The doctor wanted to freeze it. I asked to try this first. Two weeks, and it was gone."
  ],
  "v26": [
   "071312_328028af-3ec8-4283-94e1-a313254a1a0a",
   "We did the fourteen extra nights, like it says. It never came back."
  ],
  "v27": [
   "071312_9ff3f2ef-f7a8-44ee-abda-79d96685406c",
   "So before you book the freeze, try this first. It's at the link below. Get two, and the third one's free."
  ],
  "v29": [
   "071312_eb3bead2-041a-4906-b809-458db6f19b55",
   "And if it's not gone, you get your money back. That's a ninety-day guarantee."
  ]
 },
