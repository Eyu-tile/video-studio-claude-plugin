#!/usr/bin/env bash
# video-studio CLI: `vs <command> [args]`
# Tools ship with the plugin; your style files and projects live in a workspace
# folder: $VS_WORKSPACE, else <git root or cwd>/video-studio.
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do src="$(readlink "$src")"; done
root="$(cd "$(dirname "$src")/.." && pwd)"
tools="$root/tools"
venv="${VS_VENV:-$HOME/.cache/video-studio/venv}"
py="python3"
[ -x "$venv/bin/python" ] && py="$venv/bin/python"
ws="${VS_WORKSPACE:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/video-studio}"

init_ws() {
  mkdir -p "$ws/style" "$ws/projects" "$ws/library/assets"
  for f in brand.md moves.md notes.md; do
    [ -f "$ws/style/$f" ] || cp "$root/defaults/$f" "$ws/style/$f"
  done
  gi="$ws/.gitignore"
  if [ ! -f "$gi" ]; then
    printf 'projects/*\n!projects/.gitkeep\nstyle/refs/\n' > "$gi"
    touch "$ws/projects/.gitkeep"
  fi
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  transcribe|pack|propose_cuts|silences|render|captions|filmstrip|qa|export_edl|ingest|scenes|beats|sync|multicam|convert|thumbs|sfx|packs|music|proxy|breakdown|edl|notes|review|ai|translate|ads|watch|gen|higgsfield|task|learn|present|social|lessons|fix)
    exec "$py" "$tools/$cmd.py" "$@" ;;
  cuts) exec "$py" "$tools/propose_cuts.py" "$@" ;;
  fetch) exec "$py" "$tools/assets.py" "$@" ;;
  add) exec "$py" "$tools/assets.py" add "$@" ;;
  keys) exec "$py" "$tools/keys.py" "$@" ;;
  credits) exec "$py" "$tools/assets.py" credits "$@" ;;
  export) exec "$py" "$tools/export_edl.py" "$@" ;;
  probe) exec ffprobe -v error -show_entries format=duration:stream=codec_type,codec_name,width,height,avg_frame_rate,sample_rate,channels -of compact "$@" ;;
  init) init_ws; echo "workspace ready: $ws (style/brand.md, moves.md, notes.md, projects/)" ;;
  new)
    name="${1:?usage: vs new <project-name>}"
    init_ws
    d="$ws/projects/$name"
    mkdir -p "$d"/{raw,refs,work/gfx,out} "$d"/assets/{broll,images,logos,music,sfx,fonts,luts,graphics}
    [ -f "$d/project.md" ] || sed "s/{{NAME}}/$name/g" "$root/defaults/project.md" > "$d/project.md"
    echo "created $d (put footage in raw/)" ;;
  where) echo "plugin: $root"; echo "workspace: $ws"; echo "venv: $venv" ;;
  setup) VS_VENV="$venv" VS_ROOT="$root" exec bash "$tools/setup.sh" "$@" ;;
  doctor) VS_VENV="$venv" VS_ROOT="$root" exec bash "$tools/setup.sh" --check ;;
  earshot)
    eh="${VS_EARSHOT_HOME:-$HOME/.cache/video-studio/earshot}"
    [ -x "$eh/.venv/bin/python" ] || { echo "earshot not installed: vs setup --earshot" >&2; exit 1; }
    exec "$eh/.venv/bin/python" -m earshot "$@" ;;
  rea)
    rh="${VS_REA_HOME:-$HOME/.cache/video-studio/rea-video}"
    [ -x "$rh/bin/rea-video" ] || { echo "rea-video not installed: vs setup --rea" >&2; exit 1; }
    exec "$rh/bin/rea-video" "$@" ;;
  yt-dlp) if [ -x "$venv/bin/yt-dlp" ]; then exec "$venv/bin/yt-dlp" "$@"; else exec yt-dlp "$@"; fi ;;
  help|-h|--help)
    cat <<'HELP'
vs <command>                                         video-studio plugin
 setup / workspace
  setup [--packs] [--earshot] [--remotion] [--rea]  install whisper venv, numpy, yt-dlp, gdown; free SFX packs / earshot / Remotion / rea-video
  doctor                  check tools
  init                    create ./video-studio/{style,projects} here
  new <name>              video-studio/projects/<name>/{raw,work,out} + project.md
  where                   plugin, workspace and venv paths
 understand footage
  probe <file>            stream info
  ingest <dir> -o work/media            catalogue clips + contact sheets
  transcribe <in> -o work/transcript   word timestamps [--model large-v3 --lang en --prompt "names"]
  pack <transcript.json> -o x.md       LLM-readable transcript
  scenes <in> -o work/scenes           shot detection + sheet (b-roll, measuring references)
  watch <link|file> -o work/watch/x     download + watch any video link (yt-dlp sites, Instagram fallback, Drive, direct): watch.md, frames, transcript
  breakdown <ref.mp4> -o work/ref     how a reference was made: cuts, camera moves, look, beat sync, hits + remake_edl.json
  rea decompose <ref.mp4> -o out/ref   deep forensics (optional, vs setup --rea): live/AI/3D/screen per shot, OCR text
  silences <in> -o work/sil.json [--edl work/edl.json]
  filmstrip <video> -o x.png --every 5 | --at 1,2 | --cuts edl.json
  beats detect <music> -o work/beats.json
  sync <ref> <other>... -o work/sync.json   align cameras/recorders by audio
 get media
  fetch search "<query>" --type video|photo|music|sfx --project P [--provider archive,youtube,wikipedia,...]
  fetch get <results.json> 2 5 7 [--quality hd --section 95-110]  download picks / only a section (logged with licences)
  fetch inspect <results.json> N | archive:<id> [--window 4:00-9:00 --file f --page 2]   archive film: scenes + keyframe sheet
  fix <project> "<time> <note>" ...   revision step 1: the exact words, pauses, shots and cut commands at each note
  fix <project> --render [--how "..."]  revision step 2: captions, render only what changed, check, before/after
  lessons brief|add|learn|check|list|retire --brand <Client>   what feedback taught us, applied and QA-checked
  present <final.mp4> --project P [--task CODE --version v2]   Frame.io-style review page: comments pinned to frames
  present notes <comments.json|csv> -o notes.txt | present link <dir> <url> | present pref [ask|always|never]
  social prep <final.mp4> --platforms tiktok,reels,shorts,youtube,linkedin,x --project P   files + captions to approve
  social check <post.json> | social log <post.json> <platform> --url U | social pref [ask|never]   (posts via Composio)
  add <files|folders|zips|URLs>... --project P [--as broll|music|sfx|logo|font|lut|ref|raw] | --library
  keys ask <provider> [--project P]    pop-up to enter an API key (hidden; per project or machine-wide)
  keys set|unset|check|list|exec       elevenlabs heygen openai gemini (audio), pexels pixabay unsplash freesound jamendo (stock)
  credits --project P     regenerate assets/CREDITS.md
 build the edit
  cuts <transcript.json> -o work/edl.json [--max-pause 0.45]
  beats snap <edl> --beats work/beats.json -o work/edl.beat.json [--every 2]
  multicam --sync s.json --angle V=MIC ... [--wide V] --mix A --end T -o work/edl.json
  captions <transcript.json> <edl.json> -o work/captions --style bold-pop|clean|minimal|karaoke --aspect 9:16
  render <edl.json> -o out/draft.mp4 [--preview --preset reels --captions c.ass --range 10-20]
  edl show|at|lint|trim|split|cut|delete|move|insert|set|undo|redo|history|diff <edl>   small edits with version history
  review <edl> [--preset reels --captions c.ass --transcript t.json]   lint + preview render + QA + images -> work/review/rNN/review.md
  notes add work/notes.json --edl work/edl.json notes.txt | list | done <id> --how "..."   timestamped feedback as a checklist
  translate export <transcript> <edl> -o work/tr/es.json --lang es | check | subs | dub --clips dir   subtitles + dubbing
  ads brief work/brief.json | plan <brief> -o work/ads | qa <video> --edl e --brief b | sheet out/ads -o review.html   UGC/VSL ads
  learn source|scan|sample|next|tag|atlas|find|fetch|use|status <Library>   learn a client's footage from Drive, Frame.io, Dropbox, OneDrive, web pages, links or a folder
  task new|deliver|feedback|resume|done|note|restore|list <CODE>   client task history by code: versions, feedback, pick up where you left off
  higgsfield add <account> | list | use <account> [--project p] [--workspace id] | current | remove   one MCP connection per Higgsfield account
  gen plan <script.json> | next | done <jobs> <id> --url u | fetch --project p | edl -o e.json   AI presenter + b-roll via Higgsfield MCP
  proxy <files|folder> [--height 540]                                 light proxies for 4K/long sources (used by --preview)
  ai track <edl> --aspect 9:16 | match <ref> <clip> -o x.cube | stems | cutout | upscale | interpolate | status   (AI with fallbacks)
 music & sound design
  music analyze <track> | music fit <track> --edl e.json -o work/music_fit.wav   BPM/sections; fit to edit length on downbeats
  packs list | packs install --defaults | packs add <git-url> --name n --path p --license L   free GitHub sound libraries
  sfx plan --edl e.json | --hyperframes dir | --video v.mp4 [--style talking-head|tutorial|ugc-ad|montage|launch]
           [--words draft_words.json] [--risers] -o work/sfx_plan.json   find every moment, place measured recordings
  sfx apply <video> --plan p.json -o out.mp4 [--stem sfx.wav]  |  sfx merge <edl> --plan p.json -o edl.sfx.json
  sfx plan ... --snap out/draft.mp4 --sheet   snap cues to the frame the picture changes; frame per cue to judge
  sfx check --plan p.json                      measured landing of every sound vs its frame (EBU R37 limits)
  sfx library | sfx analyse <files|dirs> | sfx bank --from earshot   what's available / onset-hit-crest-level / earshot bank
  earshot critique <video> | timeline <video> | describe <wav> | ...  (optional; vs setup --earshot)
 check & deliver
  qa <video> --edl e.json --transcript t.json [--preset reels --max-length 60]
  convert <in> -o out.gif|.webm|.mov|.mp3|.wav|.mp4 [--target-mb 15 --enhance-voice --height 1080]
  thumbs <video> -o work/thumbs [--at 12.4 --title "TEXT" --size 1280x720]
  export <edl.json> -o out/rough_cut   CMX3600 .edl + .fcpxml for Premiere/Resolve/FCP
  yt-dlp <args>           downloader from the plugin venv
HELP
    ;;
  *) echo "unknown command: $cmd (try: vs help)" >&2; exit 2 ;;
esac
