    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning server/seed/seed.js",
    "check:content": "node server/content/check.js",
    "test": "node --no-warnings=ExperimentalWarning --test tests/*.test.js"
