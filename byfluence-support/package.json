    "minisearch": "^7.2.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
